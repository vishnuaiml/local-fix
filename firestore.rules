rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in [
          'vishnu68c@gmail.com',
          'vishnuchinnarasu92@gmail.com',
          'admin@nammaservices.in'
        ] ||
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && (
        request.resource.data.role in ['customer', 'provider'] || isAdmin()
      );
      allow update: if isOwner(userId) && (
        request.resource.data.role == resource.data.role || isAdmin()
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Providers Collection
    match /providers/{providerId} {
      allow get: if resource.data.verificationStatus == 'approved' || isOwner(providerId) || isAdmin();
      allow list: if true;
      allow create: if isSignedIn() && (
        request.resource.data.verificationStatus == 'pending' || isAdmin()
      );
      allow update: if (
        isOwner(providerId) && request.resource.data.verificationStatus == resource.data.verificationStatus
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // 3. Bookings Collection
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow update: if isSignedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 4. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin();
    }

    // 5. Complaints Collection
    match /complaints/{complaintId} {
      allow get: if isSignedIn() && (
        resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      allow create: if isSignedIn() && (
        request.resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
