# LocalFix – Local Services Booking Marketplace
# Environment Configuration Template

# Server & Runtime
PORT=3000
NODE_ENV=development
CLIENT_URL="http://localhost:3000"

# Firebase Configuration
# Managed automatically via firebase-applet-config.json
FIREBASE_PROJECT_ID="seventh-axon-bf4nj"

# TiDB Cloud Database (Serverless Distributed MySQL)
DB_HOST="gateway01.ap-northeast-1.prod.aws.tidbcloud.com"
DB_PORT="4000"
DB_USER="4JsiwENyAMmnJAx.root"
DB_PASSWORD="your-tidb-password"
DB_NAME="localfix"
DB_SSL="true"
DB_SSL_CA="./isrgrootx1.pem"

# Cloud SQL / PostgreSQL Database (Direct connection)
SQL_HOST="/cloudsql/project:region:instance"
SQL_DB_NAME="localfix_db"
SQL_USER="postgres"
SQL_PASSWORD="your-password"

# JWT & Session Security
JWT_SECRET="localfix_super_secure_jwt_token_secret_min_32_chars"
SESSION_SECRET="localfix_cookie_session_secret_passphrase"

# Google AI & Studio Runtime
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
